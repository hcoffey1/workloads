perf/x86/intel/ds: apply BPF sample filter to large-PEBS batched records

With large PEBS, intel_pmu_drain_pebs_*() emits all but the last record via
perf_event_output(), bypassing __perf_event_overflow() and therefore the
event's BPF_PROG_TYPE_PERF_EVENT program (PERF_EVENT_IOC_SET_BPF). Run the
program on those records too (and on the last record in a non-PMI drain) so
returning 0 drops the sample before it reaches the ring buffer, without
routing batched records through the interrupt-accounting overflow path.

Against linux 7.3.4.

--- a/kernel/events/core.c
+++ b/kernel/events/core.c
@@ -10740,6 +10740,20 @@
 #endif
 
 /*
+ * Run the event's BPF_PROG_TYPE_PERF_EVENT program as a sample filter for
+ * samples emitted without going through __perf_event_overflow(), e.g. the
+ * batched records of an x86 large-PEBS drain. Returns false to drop.
+ */
+bool perf_event_bpf_filter_sample(struct perf_event *event,
+				  struct perf_sample_data *data,
+				  struct pt_regs *regs)
+{
+	if (event->prog && event->prog->type == BPF_PROG_TYPE_PERF_EVENT)
+		return bpf_overflow_handler(event, data, regs);
+	return true;
+}
+
+/*
  * Generic event overflow handling, sampling.
  */
 
--- a/include/linux/perf_event.h
+++ b/include/linux/perf_event.h
@@ -1483,6 +1483,10 @@
 				 struct perf_sample_data *data,
 				 struct pt_regs *regs);
 
+extern bool perf_event_bpf_filter_sample(struct perf_event *event,
+					 struct perf_sample_data *data,
+					 struct pt_regs *regs);
+
 extern void perf_event_output_forward(struct perf_event *event,
 				     struct perf_sample_data *data,
 				     struct pt_regs *regs);
